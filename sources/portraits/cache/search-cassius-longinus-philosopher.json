              "extmetadata": {
                "DateTime": {
                  "value": "2018-10-26 22:53:52",
                  "source": "mediawiki-metadata",
                  "hidden": ""
                },
                "ObjectName": {
                  "value": "C. Cassius Longinus, aureus, 42 BC, RRC 499-1",
                  "source": "mediawiki-metadata"
