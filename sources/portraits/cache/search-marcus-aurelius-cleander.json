                "srcset": "https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/IllustrationsDiurnalLepidopteraPlate4.jpg/960px-IllustrationsDiurnalLepidopteraPlate4.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"
              },
              "url": "https://upload.wikimedia.org/wikipedia/commons/5/5a/IllustrationsDiurnalLepidopteraPlate4.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
              "descriptionurl": "https://commons.wikimedia.org/wiki/File:IllustrationsDiurnalLepidopteraPlate4.jpg",
              "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=18361062",
              "extmetadata": {
                "DateTime": {
                  "value": "2012-02-12 18:10:19",
                  "source": "mediawiki-metadata",
                  "hidden": ""
                },
                "ObjectName": {
                  "value": "IllustrationsDiurnalLepidopteraPlate4",
